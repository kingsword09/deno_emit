{
  "lock": false,
  "tasks": {
    "test": "deno test -A",
    "update-snapshots": "deno test -A -- --update",
    "build": "cp LICENSE js/LICENSE && deno run -A jsr:@deno/wasmbuild@0.19.2 --out js"
  },
  "exclude": [
    "lib",
    "static",
    "testdata",
    "target",
    "tests/__snapshots__"
  ],
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.9"
  }
}
